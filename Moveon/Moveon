<script type="module">

import {
    auth
} from "./firebase-config.js";

import {
    onAuthStateChanged,
    signOut
} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";

import {
    database
} from "./firebase-config.js";

import {
    ref,
    get,
    update
} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-database.js";


let currentUser = null;

const TOTAL_LESSONS = 6;


/* =========================
   AUTH
========================= */

onAuthStateChanged(auth, async (user) => {

    if (!user) {

        window.location.replace("login.html");

        return;
    }

    currentUser = user;

    document.body.classList.add("auth-ready");

    await loadLessonProgress();

});


/* =========================
   LOAD PROGRESS
========================= */

async function loadLessonProgress(){

    try{

        const snapshot = await get(
            ref(
                database,
                `users/${currentUser.uid}/lessons`
            )
        );

        if(snapshot.exists()){

            const data = snapshot.val();

            Object.keys(data).forEach(id => {

                if(data[id]?.completed === true){

                    markCompleted(id);

                }

            });

        }

        updateProgress();

    }catch(error){

        console.error(
            "Lesson progress error:",
            error
        );

        updateProgress();

    }

}


/* =========================
   OPEN LESSON
========================= */

window.openLesson = async function(id){

    const content =
        document.getElementById(
            "content" + id
        );

    const button =
        document.getElementById(
            "lessonBtn" + id
        );

    if(!content || !button){
        return;
    }

    content.classList.toggle("show");

    if(button.dataset.completed === "true"){
        return;
    }

    try{

        await update(
            ref(
                database,
                `users/${currentUser.uid}/lessons/${id}`
            ),
            {
                completed:true,
                completedAt:new Date().toISOString(),
                xp:10
            }
        );

        markCompleted(id);

        updateProgress();

        showToast(
            "Lesson completed! +10 XP 🌱"
        );

    }catch(error){

        console.error(
            "Lesson save error:",
            error
        );

        showToast(
            "Unable to save lesson."
        );

    }

};


/* =========================
   MARK COMPLETED
========================= */

function markCompleted(id){

    const button =
        document.getElementById(
            "lessonBtn" + id
        );

    if(!button){
        return;
    }

    button.textContent =
        "✓ Completed";

    button.classList.add(
        "completed"
    );

    button.dataset.completed =
        "true";

}


/* =========================
   UPDATE PROGRESS
========================= */

function updateProgress(){

    let completed = 0;

    for(let i = 1; i <= TOTAL_LESSONS; i++){

        const button =
            document.getElementById(
                "lessonBtn" + i
            );

        if(
            button &&
            button.dataset.completed ===
            "true"
        ){

            completed++;

        }

    }

    const percent =
        Math.round(
            (completed / TOTAL_LESSONS) * 100
        );

    document.getElementById(
        "completedCount"
    ).textContent =
        completed + " Lessons";

    document.getElementById(
        "progressPercent"
    ).textContent =
        percent + "%";

    document.getElementById(
        "progressFill"
    ).style.width =
        percent + "%";

}


/* =========================
   BACK
========================= */

window.goBack = function(){

    window.location.href =
        "home.html";

};


/* =========================
   LOGOUT
========================= */

window.logout = async function(){

    try{

        await signOut(auth);

        window.location.replace(
            "login.html"
        );

    }catch(error){

        console.error(
            "Logout error:",
            error
        );

        showToast(
            "Unable to logout."
        );

    }

};


/* =========================
   TOAST
========================= */

window.showToast = function(message){

    const toast =
        document.getElementById(
            "toast"
        );

    if(!toast){
        return;
    }

    toast.textContent =
        message;

    toast.classList.add(
        "show"
    );

    setTimeout(() => {

        toast.classList.remove(
            "show"
        );

    },2500);

};

</script>

