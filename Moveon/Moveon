<div class="toast" id="toast"></div>
<script type="module">

import { auth } from "./firebase-config.js";

import {
    onAuthStateChanged
} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";

import {
    saveMood as saveMoodToFirebase,
    getMoods
} from "./storage.js";


const moodButtons =
    document.querySelectorAll(".mood");

const mainMood =
    document.getElementById("mainMood");

const selectedMood =
    document.getElementById("selectedMood");

const intensity =
    document.getElementById("intensity");

const intensityValue =
    document.getElementById("intensityValue");


let selectedMoodData = null;
let selectedTags = [];
let firebaseMoods = {};

let currentUser = null;


/* =========================================
   AUTHENTICATION
========================================= */

onAuthStateChanged(auth, async (user) => {

    if (!user) {

        window.location.href = "login.html";
        return;

    }

    currentUser = user;

    await loadMoodsFromFirebase();

});


/* =========================================
   MOOD SELECTION
========================================= */

moodButtons.forEach(button => {

    button.addEventListener("click", () => {

        moodButtons.forEach(item => {
            item.classList.remove("active");
        });

        button.classList.add("active");

        const mood =
            button.dataset.mood;

        const emoji =
            button.dataset.emoji;

        selectedMoodData = {
            mood: mood,
            emoji: emoji
        };

        mainMood.textContent = emoji;

        selectedMood.innerHTML =
            `You're feeling <strong>${mood}</strong> today 💜`;

    });

});


/* =========================================
   INTENSITY
========================================= */

intensity.addEventListener("input", () => {

    intensityValue.textContent =
        intensity.value + "/10";

});


/* =========================================
   TAGS
========================================= */

document.querySelectorAll(".tag").forEach(tag => {

    tag.addEventListener("click", () => {

        tag.classList.toggle("active");

        const value =
            tag.textContent.trim();

        if (tag.classList.contains("active")) {

            if (!selectedTags.includes(value)) {
                selectedTags.push(value);
            }

        } else {

            selectedTags =
                selectedTags.filter(
                    item => item !== value
                );

        }

    });

});


/* =========================================
   SAVE MOOD TO FIREBASE
========================================= */

async function saveMood() {

    if (!currentUser) {

        showToast("Please login first 💜");
        return;

    }

    if (!selectedMoodData) {

        showToast("Please choose your mood first 💜");
        return;

    }


    const saveButton =
        document.querySelector(".save-btn");


    saveButton.disabled = true;

    saveButton.textContent =
        "Saving...";


    const now =
        new Date();


    const entry = {

        mood: selectedMoodData.mood,

        emoji: selectedMoodData.emoji,

        intensity: Number(intensity.value),

        tags: [...selectedTags],

        date: now.toLocaleDateString(),

        timestamp: Date.now()

    };


    try {

        const moodId =
            await saveMoodToFirebase(entry);


        if (!moodId) {

            throw new Error(
                "Mood could not be saved."
            );

        }


        /* Add Firebase ID locally */

        entry.firebaseId =
            moodId;


        /*
        Update local Firebase data
        so the screen refreshes immediately.
        */

        firebaseMoods[moodId] =
            entry;


        showToast("Mood saved successfully 💜");


        renderHistory();

        renderChart();


        /*
        Reset selection after saving
        */

        selectedMoodData = null;

        selectedTags = [];

        moodButtons.forEach(item => {
            item.classList.remove("active");
        });

        document.querySelectorAll(".tag").forEach(tag => {
            tag.classList.remove("active");
        });

        mainMood.textContent = "💭";

        selectedMood.textContent =
            "Select a mood to continue";

        intensity.value = 5;

        intensityValue.textContent =
            "5/10";


    } catch (error) {

        console.error(
            "Firebase Mood Save Error:",
            error
        );

        showToast(
            "Unable to save mood. Please try again."
        );

    }


    saveButton.disabled = false;

    saveButton.textContent =
        "💜 Save Today's Mood";

}


/* =========================================
   LOAD MOODS FROM FIREBASE
========================================= */

async function loadMoodsFromFirebase() {

    try {

        const data =
            await getMoods();


        firebaseMoods =
            data || {};


        renderHistory();

        renderChart();


    } catch (error) {

        console.error(
            "Firebase Mood Load Error:",
            error
        );


        firebaseMoods = {};

        renderHistory();

        renderChart();

        showToast(
            "Unable to load mood history."
        );

    }

}


/* =========================================
   CONVERT FIREBASE DATA TO ARRAY
========================================= */

function getMoodArray() {

    return Object.entries(firebaseMoods)

        .map(([id, item]) => ({

            ...item,

            firebaseId: id

        }))

        .sort(
            (a, b) =>
                Number(b.timestamp || 0) -
                Number(a.timestamp || 0)
        );

}


/* =========================================
   HISTORY
========================================= */

function renderHistory() {

    const container =
        document.getElementById("history");


    const moods =
        getMoodArray();


    if (moods.length === 0) {

        container.innerHTML = `
            <div class="empty">
                Your mood history will appear here 🌱
            </div>
        `;

        return;

    }


    container.innerHTML =

        moods.slice(0, 5)

        .map(item => `

            <div class="history-item">

                <div class="history-emoji">
                    ${escapeHTML(item.emoji || "💭")}
                </div>

                <div class="history-info">

                    <strong>
                        ${escapeHTML(item.mood || "Mood")}
                    </strong>

                    <small>

                        ${escapeHTML(item.date || "")}

                        ${
                            Array.isArray(item.tags) &&
                            item.tags.length
                            ?
                            " • " +
                            item.tags
                                .slice(0, 2)
                                .map(tag =>
                                    escapeHTML(tag)
                                )
                                .join(", ")
                            :
                            ""
                        }

                    </small>

                </div>

                <div class="intensity-dot">

                    ${Number(item.intensity || 0)}/10

                </div>

            </div>

        `)

        .join("");

}


/* =========================================
   WEEKLY CHART
========================================= */

function renderChart() {

    const chart =
        document.getElementById("chart");


    const moods =
        getMoodArray();


    const days = [];


    for (let i = 6; i >= 0; i--) {

        const date =
            new Date();

        date.setDate(
            date.getDate() - i
        );

        days.push(date);

    }


    const values =

        days.map(day => {

            const dayString =
                day.toLocaleDateString();


            /*
            Find latest mood
            for this particular day
            */

            const entry =

                moods.find(item => {

                    return item.date === dayString;

                });


            return entry
                ? Number(entry.intensity || 0)
                : 0;

        });


    chart.innerHTML =

        days.map((day, index) => {

            const height =

                values[index] > 0

                ? values[index] * 10

                : 7;


            return `

                <div class="day">

                    <div class="bar-wrap">

                        <div
                            class="bar"
                            style="
                                height:${height}px;
                                opacity:${values[index] ? 1 : .18};
                            "
                            title="${
                                values[index]
                                ? values[index] + "/10"
                                : "No entry"
                            }"
                        ></div>

                    </div>

                    <span>

                        ${
                            day.toLocaleDateString(
                                "en-US",
                                {
                                    weekday:"short"
                                }
                            ).slice(0,2)
                        }

                    </span>

                </div>

            `;

        })

        .join("");


    const valid =
        values.filter(
            value => value > 0
        );


    if (valid.length) {

        const average =

            valid.reduce(
                (a, b) => a + b,
                0
            ) / valid.length;


        document.getElementById(
            "averageMood"
        ).textContent =
            "Avg " +
            average.toFixed(1) +
            "/10";

    } else {

        document.getElementById(
            "averageMood"
        ).textContent =
            "No data yet";

    }

}


/* =========================================
   ESCAPE HTML
========================================= */

function escapeHTML(value) {

    const div =
        document.createElement("div");

    div.textContent =
        String(value ?? "");

    return div.innerHTML;

}


/* =========================================
   TOAST
========================================= */

function showToast(message) {

    const toast =
        document.getElementById("toast");


    toast.textContent =
        message;


    toast.classList.add("show");


    setTimeout(() => {

        toast.classList.remove("show");

    }, 2200);

}


/* =========================================
   BACK BUTTON
========================================= */

function goBack() {

    if (history.length > 1) {

        history.back();

    } else {

        window.location.href =
            "home.html";

    }

}


/* =========================================
   MAKE INLINE HTML EVENTS WORK
========================================= */

window.saveMood =
    saveMood;

window.goBack =
    goBack;

window.showToast =
    showToast;


/* =========================================
   INITIAL UI
========================================= */

intensityValue.textContent =
    intensity.value + "/10";

</script>

<script type="module" src="app.js"></script>

 
<script src="emoji-sounds.js"></script>
