<script type="module">

/*
==================================================
FIREBASE IMPORTS
==================================================
*/

import {
    auth,
    database
} from "./firebase-config.js";


import {
    onAuthStateChanged
} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";


import {
    ref,
    get
} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-database.js";


import {
    getProfile,
    saveMood,
    getMoods,
    saveChallengeProgress,
    getChallenges
} from "./storage.js";


/*
==================================================
GLOBAL USER
==================================================
*/

let currentUser = null;


/*
==================================================
AUTH TIMEOUT
==================================================

Agar Firebase module kisi reason se load na ho,
Home page permanently visible nahi rahega.

8 seconds ke baad login page par bhej denge.

*/

const authTimeout = setTimeout(
    function() {

        if (!currentUser) {

            console.error(
                "Firebase authentication timed out."
            );

            window.location.replace(
                "login.html"
            );

        }

    },
    8000
);


/*
==================================================
AUTH CHECK
==================================================
*/

onAuthStateChanged(
    auth,
    async (user) => {

        clearTimeout(authTimeout);


        if (!user) {

            console.log(
                "No authenticated user."
            );

            window.location.replace(
                "login.html"
            );

            return;

        }


        currentUser = user;


        console.log(
            "MoveOn user:",
            currentUser.uid
        );


        /*
        IMPORTANT:
        Firebase auth verified.
        Ab Home page visible hoga.
        */

        document.body.classList.add(
            "auth-ready"
        );


        await loadHomeData();

    },
    (error) => {

        clearTimeout(authTimeout);

        console.error(
            "Home Auth Error:",
            error
        );

        window.location.replace(
            "login.html"
        );

    }
);


/*
==================================================
LOAD ALL HOME DATA
==================================================
*/

async function loadHomeData() {

    await loadUserName();

    await loadMood();

    await loadChallenge();

    await loadProgress();

    await loadNoContact();

}


/*
==================================================
LOAD USER NAME
==================================================
*/

async function loadUserName() {

    try {

        const profile =
            await getProfile();


        const name =
            profile?.name ||
            currentUser.displayName ||
            "Friend";


        const welcomeTitle =
            document.getElementById(
                "welcomeTitle"
            );


        if (welcomeTitle) {

            welcomeTitle.textContent =
                "Hi, " + name + " 💜";

        }


    } catch (error) {

        console.error(
            "User name loading error:",
            error
        );


        const name =
            currentUser.displayName ||
            "Friend";


        const welcomeTitle =
            document.getElementById(
                "welcomeTitle"
            );


        if (welcomeTitle) {

            welcomeTitle.textContent =
                "Hi, " + name + " 💜";

        }

    }

}


/*
==================================================
SELECT + SAVE MOOD
==================================================
*/

window.selectMood =
async function(element, mood) {


    document
        .querySelectorAll(".mood")
        .forEach(
            item => {

                item.classList.remove(
                    "active"
                );

            }
        );


    if (element) {

        element.classList.add(
            "active"
        );

    }


    try {

        const result =
            await saveMood({

                mood: mood,

                date:
                    getLocalDate(),

                source:
                    "home"

            });


        if (result) {

            localStorage.setItem(
                "moveon_mood",
                mood
            );


            showToast(
                "Mood saved: " +
                mood +
                " 💜"
            );

        } else {

            showToast(
                "Unable to save mood. Please try again."
            );

        }


    } catch (error) {

        console.error(
            "Mood save error:",
            error
        );


        showToast(
            "Unable to save mood. Please try again."
        );

    }

};


/*
==================================================
LOAD LAST MOOD
==================================================
*/

async function loadMood() {

    let savedMood = null;


    try {

        const moods =
            await getMoods();


        const entries =
            Object.values(
                moods || {}
            );


        if (entries.length > 0) {

            entries.sort(
                (a, b) => {

                    return (
                        new Date(
                            b.createdAt || 0
                        ) -
                        new Date(
                            a.createdAt || 0
                        )
                    );

                }
            );


            savedMood =
                entries[0]?.mood ||
                null;

        }


    } catch (error) {

        console.error(
            "Mood loading error:",
            error
        );

    }


    if (!savedMood) {

        savedMood =
            localStorage.getItem(
                "moveon_mood"
            );

    }


    if (!savedMood) {

        return;

    }


    document
        .querySelectorAll(".mood")
        .forEach(
            button => {

                const text =
                    button.innerText
                        .toLowerCase();


                if (
                    text.includes(
                        savedMood.toLowerCase()
                    )
                ) {

                    button.classList.add(
                        "active"
                    );

                }

            }
        );

}


/*
==================================================
COMPLETE DAILY CHALLENGE
==================================================
*/

window.completeChallenge =
async function() {

    const button =
        document.getElementById(
            "challengeButton"
        );


    if (
        button &&
        button.dataset.completed ===
        "true"
    ) {

        showToast(
            "Today's challenge is already completed 🌱"
        );

        return;

    }


    const today =
        getLocalDate();


    try {

        const result =
            await saveChallengeProgress(
                "daily",
                {

                    completed: true,

                    completedDate:
                        today,

                    title:
                        "Do something for yourself",

                    xp: 25

                }
            );


        if (!result) {

            showToast(
                "Unable to save challenge. Please try again."
            );

            return;

        }


        localStorage.setItem(
            "moveon_challenge_completed_date",
            today
        );


        updateChallengeButton();


        showToast(
            "Challenge completed! 🌱"
        );


    } catch (error) {

        console.error(
            "Challenge save error:",
            error
        );


        showToast(
            "Unable to save challenge. Please try again."
        );

    }

};


/*
==================================================
LOAD TODAY'S CHALLENGE
==================================================
*/

async function loadChallenge() {

    let completed = false;


    const today =
        getLocalDate();


    try {

        const challenges =
            await getChallenges();


        if (
            challenges &&
            challenges.daily
        ) {

            const daily =
                challenges.daily;


            if (
                daily.completed === true &&
                daily.completedDate === today
            ) {

                completed = true;

            }

        }


    } catch (error) {

        console.error(
            "Challenge loading error:",
            error
        );

    }


    if (!completed) {

        const localDate =
            localStorage.getItem(
                "moveon_challenge_completed_date"
            );


        if (localDate === today) {

            completed = true;

        }

    }


    if (completed) {

        updateChallengeButton();

    }

}


/*
==================================================
UPDATE CHALLENGE BUTTON
==================================================
*/

function updateChallengeButton() {

    const button =
        document.getElementById(
            "challengeButton"
        );


    if (!button) {

        return;

    }


    button.textContent =
        "✓ Challenge Completed";


    button.style.background =
        "#4caf91";


    button.dataset.completed =
        "true";

}


/*
==================================================
LOAD HEALING PROGRESS
==================================================
*/

async function loadProgress() {

    let profile = null;


    try {

        profile =
            await getProfile();

    } catch (error) {

        console.error(
            "Progress profile error:",
            error
        );

    }


    let startDate =
        profile?.createdAt ||
        null;


    if (
        profile?.onboarding?.completedAt
    ) {

        startDate =
            profile
                .onboarding
                .completedAt;

    }


    if (!startDate) {

        setDefaultProgress();

        return;

    }


    const start =
        new Date(startDate);


    if (
        Number.isNaN(
            start.getTime()
        )
    ) {

        setDefaultProgress();

        return;

    }


    const now =
        new Date();


    const difference =
        now.getTime() -
        start.getTime();


    let days =
        Math.floor(
            difference /
            (1000 * 60 * 60 * 24)
        ) + 1;


    if (days < 1) {

        days = 1;

    }


    const percent =
        Math.min(
            Math.round(
                (days / 30) * 100
            ),
            100
        );


    const progressDay =
        document.getElementById(
            "progressDay"
        );


    const progressPercent =
        document.getElementById(
            "progressPercent"
        );


    const progressFill =
        document.getElementById(
            "progressFill"
        );


    const progressStarted =
        document.getElementById(
            "progressStarted"
        );


    const progressMessage =
        document.getElementById(
            "progressMessage"
        );


    if (progressDay) {

        progressDay.textContent =
            "Day " + days;

    }


    if (progressPercent) {

        progressPercent.textContent =
            percent + "%";

    }


    if (progressFill) {

        progressFill.style.width =
            percent + "%";

    }


    if (progressStarted) {

        progressStarted.textContent =
            "Started " +
            formatDate(start);

    }


    if (progressMessage) {

        if (days >= 30) {

            progressMessage.textContent =
                "You've come a long way. Keep growing. 💜";

        } else if (days >= 14) {

            progressMessage.textContent =
                "You're building a stronger version of yourself.";

        } else if (days >= 7) {

            progressMessage.textContent =
                "One week of choosing yourself. Keep going.";

        }

    }

}


/*
==================================================
DEFAULT PROGRESS
==================================================
*/

function setDefaultProgress() {

    const progressDay =
        document.getElementById(
            "progressDay"
        );


    const progressPercent =
        document.getElementById(
            "progressPercent"
        );


    const progressFill =
        document.getElementById(
            "progressFill"
        );


    const progressStarted =
        document.getElementById(
            "progressStarted"
        );


    if (progressDay) {

        progressDay.textContent =
            "Day 1";

    }


    if (progressPercent) {

        progressPercent.textContent =
            "0%";

    }


    if (progressFill) {

        progressFill.style.width =
            "0%";

    }


    if (progressStarted) {

        progressStarted.textContent =
            "Your journey starts today";

    }

}


/*
==================================================
FORMAT DATE
==================================================
*/

function formatDate(date) {

    try {

        return date.toLocaleDateString(
            "en-IN",
            {
                day: "numeric",
                month: "short"
            }
        );

    } catch (error) {

        return "recently";

    }

}


/*
==================================================
LOCAL DATE
==================================================
*/

function getLocalDate() {

    const now =
        new Date();


    const year =
        now.getFullYear();


    const month =
        String(
            now.getMonth() + 1
        ).padStart(
            2,
            "0"
        );


    const day =
        String(
            now.getDate()
        ).padStart(
            2,
            "0"
        );


    return (
        year +
        "-" +
        month +
        "-" +
        day
    );

}


/*
==================================================
NO CONTACT — FIREBASE
==================================================
*/

async function loadNoContact() {

    const element =
        document.getElementById(
            "noContactDays"
        );


    if (!element) {

        return;

    }


    try {

        /*
        Firebase path:

        users/{uid}/noContact
        */

        const snapshot =
            await get(
                ref(
                    database,
                    `users/${currentUser.uid}/noContact`
                )
            );


        if (
            !snapshot.exists()
        ) {

            element.textContent =
                "0 Days";

            return;

        }


        const data =
            snapshot.val();


        if (
            !data ||
            !data.startDate
        ) {

            element.textContent =
                "0 Days";

            return;

        }


        const start =
            new Date(
                data.startDate +
                "T00:00:00"
            );


        if (
            Number.isNaN(
                start.getTime()
            )
        ) {

            element.textContent =
                "0 Days";

            return;

        }


        const now =
            new Date();


        const difference =
            now.getTime() -
            start.getTime();


        const days =
            Math.max(
                1,
                Math.floor(
                    difference /
                    (1000 * 60 * 60 * 24)
                ) + 1
            );


        element.textContent =
            days + " Days";


    } catch (error) {

        console.error(
            "Firebase No Contact loading error:",
            error
        );


        /*
        Local fallback
        */

        const saved =
            localStorage.getItem(
                "moveon_no_contact_start"
            );


        if (!saved) {

            element.textContent =
                "0 Days";

            return;

        }


        const start =
            new Date(saved);


        if (
            Number.isNaN(
                start.getTime()
            )
        ) {

            element.textContent =
                "0 Days";

            return;

        }


        const now =
            new Date();


        const difference =
            now.getTime() -
            start.getTime();


        const days =
            Math.max(
                1,
                Math.floor(
                    difference /
                    (1000 * 60 * 60 * 24)
                ) + 1
            );


        element.textContent =
            days + " Days";

    }

}


