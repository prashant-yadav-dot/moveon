<!-- =========================
     JOURNAL FIREBASE LOGIC
========================= -->

<script type="module">

import {
    saveJournal as saveJournalToFirebase,
    getJournals,
    deleteJournal,
    getProfile,
    saveProfile
} from "./storage.js";

import {
    auth
} from "./firebase-config.js";

import {
    onAuthStateChanged
} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";


/* =========================
   PROMPTS
========================= */

const prompts = [

    "What is one thing you're finding difficult to let go of today?",

    "What would you tell your best friend if they were going through what you're going through?",

    "What is something you wish you could say, but don't need to send?",

    "What made you smile today, even for a moment?",

    "What do you need more of in your life right now?",

    "What is one thing you are proud of yourself for surviving?",

    "If today could be a fresh start, what would you do differently?",

    "What part of yourself do you want to rediscover?",

    "What does peace look like for you right now?",

    "What is one small thing you can do for yourself today?",

    "What have you learned about yourself from this experience?",

    "What are three things you want your future self to remember?"

];


/* =========================
   VARIABLES
========================= */

let selectedMood = "";

let entries = [];

let currentUser = null;

let currentStreak = {
    count: 0,
    lastDate: ""
};


/* =========================
   DATE
========================= */

function updateDate(){

    const date = new Date();

    const options = {
        weekday:"long",
        month:"short",
        day:"numeric",
        year:"numeric"
    };

    document
        .getElementById("todayDate")
        .textContent =
        date.toLocaleDateString(
            "en-IN",
            options
        );

}


/* =========================
   MOOD
========================= */

window.selectMood = function(button){

    document
        .querySelectorAll(".mood")
        .forEach(function(item){

            item.classList.remove("selected");

        });


    button.classList.add("selected");


    selectedMood =
        button.dataset.mood;

};


/* =========================
   WORD COUNT
========================= */

window.updateCount = function(){

    const text =
        document
        .getElementById("journalText")
        .value;


    const characters =
        text.length;


    const words =
        text.trim()
        ? text.trim().split(/\s+/).length
        : 0;


    document
        .getElementById("wordCount")
        .textContent =
        words +
        " words • " +
        characters +
        " characters";

};


/* =========================
   SAVE JOURNAL
========================= */

window.saveJournal = async function(){

    if(!currentUser){

        showToast(
            "Please login first 🔐"
        );

        return;

    }


    const text =
        document
        .getElementById("journalText")
        .value
        .trim();


    if(!text){

        showToast(
            "Write something before saving 💜"
        );

        return;

    }


    if(!selectedMood){

        showToast(
            "Choose your mood first 🌱"
        );

        return;

    }


    const saveButton =
        document.getElementById(
            "saveButton"
        );


    saveButton.disabled = true;

    saveButton.textContent =
        "Saving...";


    const now = new Date();


    const entry = {

        mood:
            selectedMood,

        text:
            text,

        date:
            now.toLocaleDateString(
                "en-IN",
                {
                    day:"numeric",
                    month:"short",
                    year:"numeric"
                }
            ),

        timestamp:
            now.toISOString()

    };


    try{

        const journalId =
            await saveJournalToFirebase(
                entry
            );


        if(!journalId){

            throw new Error(
                "Journal could not be saved."
            );

        }


        /*
         * Firebase push() creates
         * a unique ID.
         */

        entry.id =
            journalId;


        entries.unshift(entry);


        /*
         * Update writing streak
         */

        await updateStreak();


        /*
         * Clear editor
         */

        document
            .getElementById("journalText")
            .value = "";


        selectedMood = "";


        document
            .querySelectorAll(".mood")
            .forEach(function(item){

                item.classList.remove(
                    "selected"
                );

            });


        updateCount();

        renderEntries();


        showToast(
            "Journal saved safely 💜"
        );


    }catch(error){

        console.error(
            "Firebase Journal Error:",
            error
        );


        showToast(
            "Unable to save journal. Try again."
        );


    }finally{

        saveButton.disabled = false;

        saveButton.textContent =
            "Save Journal 💜";

    }

};


/* =========================
   LOAD JOURNALS
========================= */

async function loadJournals(){

    try{

        const firebaseEntries =
            await getJournals();


        if(
            firebaseEntries &&
            typeof firebaseEntries === "object"
        ){

            entries =
                Object.keys(
                    firebaseEntries
                )
                .map(function(key){

                    return {
                        ...firebaseEntries[key],
                        id:key
                    };

                })
                .sort(function(a,b){

                    return (
                        new Date(
                            b.timestamp || 0
                        ) -
                        new Date(
                            a.timestamp || 0
                        )
                    );

                });

        }else{

            entries = [];

        }


        renderEntries();


    }catch(error){

        console.error(
            "Load Journals Error:",
            error
        );


        entries = [];

        renderEntries();


        showToast(
            "Unable to load journal entries."
        );

    }

}


/* =========================
   RENDER ENTRIES
========================= */

function renderEntries(){

    const container =
        document.getElementById(
            "entries"
        );


    container.innerHTML = "";


    if(entries.length === 0){

        container.innerHTML = `

            <div class="empty">

                Your journal entries
                will appear here.

            </div>

        `;

        return;

    }


    const moodIcons = {

        Happy:"😊",
        Calm:"😌",
        Okay:"🙂",
        Sad:"😔",
        Lonely:"🥺",
        Angry:"😡",
        Overthinking:"💭"

    };


    entries
        .slice(0,5)
        .forEach(function(entry,index){

            const div =
                document.createElement(
                    "div"
                );


            div.className =
                "entry";


            div.onclick =
                function(){

                    openEntry(index);

                };


            const mood =
                escapeHTML(
                    entry.mood || "Mood"
                );


            const text =
                escapeHTML(
                    (entry.text || "")
                    .substring(0,65)
                );


            div.innerHTML = `

                <div class="entry-mood">

                    ${moodIcons[entry.mood] || "💜"}

                </div>

                <div class="entry-info">

                    <strong>
                        ${mood}
                    </strong>

                    <span>
                        ${text}
                        ${(entry.text || "").length > 65 ? "..." : ""}
                    </span>

                </div>

                <div class="entry-arrow">
                    →
                </div>

            `;


            container.appendChild(div);

        });

}


/* =========================
   OPEN ENTRY
========================= */

function openEntry(index){

    const entry =
        entries[index];


    if(!entry){
        return;
    }


    document
        .getElementById("modalDate")
        .textContent =
        (entry.date || "") +
        " • " +
        (entry.mood || "");


    document
        .getElementById("modalContent")
        .textContent =
        entry.text || "";


    document
        .getElementById("entryModal")
        .classList.add("show");

}


/* =========================
   CLOSE MODAL
========================= */

window.closeModal = function(){

    document
        .getElementById("entryModal")
        .classList.remove("show");

};


/* =========================
   CLEAR ENTRIES
========================= */

window.clearEntries = async function(){

    if(entries.length === 0){

        showToast(
            "There are no entries to clear."
        );

        return;

    }


    const confirmed =
        confirm(
            "Delete all journal entries permanently?"
        );


    if(!confirmed){
        return;
    }


    try{

        showToast(
            "Deleting entries..."
        );


        /*
         * Delete every Firebase entry.
         */

        for(
            const entry of entries
        ){

            if(entry.id){

                await deleteJournal(
                    entry.id
                );

            }

        }


        entries = [];


        currentStreak = {
            count:0,
            lastDate:""
        };


        /*
         * Reset streak in Firebase.
         */

        await saveProfile({

            journalStreak:0,

            journalStreakLastDate:""

        });


        document
            .getElementById(
                "streakNumber"
            )
            .textContent =
            "0";


        renderEntries();


        showToast(
            "Journal entries cleared."
        );


    }catch(error){

        console.error(
            "Clear Journal Error:",
            error
        );


        showToast(
            "Unable to clear entries."
        );

    }

};


/* =========================
   NEW PROMPT
========================= */

window.newPrompt = function(){

    const random =
        Math.floor(
            Math.random() *
            prompts.length
        );


    document
        .getElementById("sidePrompt")
        .textContent =
        prompts[random];


    document
        .getElementById("promptText")
        .textContent =
        prompts[random];

};


/* =========================
   DATE KEY
========================= */

function getLocalDateKey(){

    const date =
        new Date();


    const year =
        date.getFullYear();


    const month =
        String(
            date.getMonth() + 1
        ).padStart(2,"0");


    const day =
        String(
            date.getDate()
        ).padStart(2,"0");


    return (
        year +
        "-" +
        month +
        "-" +
        day
    );

}


/* =========================
   UPDATE STREAK
========================= */

async function updateStreak(){

    const today =
        getLocalDateKey();


    let count =
        currentStreak.count || 0;


    const lastDate =
        currentStreak.lastDate || "";


    if(lastDate === today){

        document
            .getElementById(
                "streakNumber"
            )
            .textContent =
            count;

        return;

    }


    const yesterday =
        new Date();


    yesterday.setDate(
        yesterday.getDate() - 1
    );


    const yesterdayKey =
        (
            yesterday.getFullYear() +
            "-" +
            String(
                yesterday.getMonth() + 1
            ).padStart(2,"0") +
            "-" +
            String(
                yesterday.getDate()
            ).padStart(2,"0")
        );


    if(lastDate === yesterdayKey){

        count++;

    }else{

        count = 1;

    }


    currentStreak = {

        count:count,

        lastDate:today

    };


    await saveProfile({

        journalStreak:
            count,

        journalStreakLastDate:
            today

    });


    document
        .getElementById(
            "streakNumber"
        )
        .textContent =
        count;

}


/* =========================
   LOAD STREAK
========================= */

async function loadStreak(){

    try{

        const profile =
            await getProfile();


        if(profile){

            currentStreak = {

                count:
                    Number(
                        profile.journalStreak
                    ) || 0,

                lastDate:
                    profile.journalStreakLastDate ||
                    ""

            };

        }


        document
            .getElementById(
                "streakNumber"
            )
            .textContent =
            currentStreak.count || 0;


    }catch(error){

        console.error(
            "Load Streak Error:",
            error
        );

    }

}


/* =========================
   RESTORE MOOD
========================= */

async function restoreMood(){

    try{

        const profile =
            await getProfile();


        if(
            profile &&
            profile.lastJournalMood
        ){

            selectedMood =
                profile.lastJournalMood;


            document
                .querySelectorAll(".mood")
                .forEach(function(button){

                    if(
                        button.dataset.mood ===
                        selectedMood
                    ){

                        button.classList.add(
                            "selected"
                        );

                    }

                });

        }

    }catch(error){

        console.error(
            "Restore Mood Error:",
            error
        );

    }

}


/* =========================
   SAVE LAST MOOD
========================= */

async function saveLastMood(){

    if(!selectedMood){
        return;
    }


    try{

        await saveProfile({

            lastJournalMood:
                selectedMood

        });

    }catch(error){

        console.error(
            "Save Mood Error:",
            error
        );

    }

}


/*
 * Override selectMood so the
 * selected mood also gets stored
 * in Firebase.
 */

const originalSelectMood =
    window.selectMood;


window.selectMood =
    function(button){

        originalSelectMood(button);

        saveLastMood();

    };


/* =========================
   ESCAPE HTML
========================= */

function escapeHTML(text){

    const div =
        document.createElement(
            "div"
        );


    div.textContent =
        text || "";


    return div.innerHTML;

}


/* =========================
   TOAST
========================= */

function showToast(message){

    const toast =
        document.getElementById(
            "toast"
        );


    toast.textContent =
        message;


    toast.classList.add(
        "show"
    );


    setTimeout(function(){

        toast.classList.remove(
            "show"
        );

    },2500);

}


/* =========================
   CLOSE MODAL OUTSIDE
========================= */

document
    .getElementById("entryModal")
    .addEventListener(
        "click",
        function(event){

            if(
                event.target === this
            ){

                window.closeModal();

            }

        }
    );


/* =========================
   AUTH STATE
========================= */

onAuthStateChanged(
    auth,
    async function(user){

        if(!user){

            return;

        }


        currentUser =
            user;


        updateDate();

        updateCount();

        await loadJournals();

        await loadStreak();

        await restoreMood();

    }
);

</script>

