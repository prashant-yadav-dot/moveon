function todayKey() {
  const d = new Date();
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`;
}
function yesterdayKey() {
  const d = new Date();
  d.setDate(d.getDate()-1);
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`;
}
function hashString(s) {
  let h = 2166136261;
  for (let i=0;i<s.length;i++) { h ^= s.charCodeAt(i); h = Math.imul(h,16777619); }
  return h >>> 0;
}
function localKey() { return `${LOCAL_CHALLENGES}_${currentUser?.uid || "guest"}`; }
function statsKey() { return `${LOCAL_STATS}_${currentUser?.uid || "guest"}`; }

function readLocal() {
  try {
    firebaseChallenges = JSON.parse(localStorage.getItem(localKey()) || "{}") || {};
    challengeStats = {...challengeStats, ...(JSON.parse(localStorage.getItem(statsKey()) || "{}") || {})};
  } catch {}
}
function writeLocal() {
  try {
    localStorage.setItem(localKey(), JSON.stringify(firebaseChallenges));
    localStorage.setItem(statsKey(), JSON.stringify(challengeStats));
  } catch {}
}

function getOnboardingFromLocal() {
  try {
    return JSON.parse(localStorage.getItem("moveon_onboarding") || "{}") || {};
  } catch { return {}; }
}

async function loadOnboarding() {
  const local = getOnboardingFromLocal();
  onboarding = {...onboarding, ...local};

  try {
    const profile = await getProfile();
    if (profile?.onboarding) onboarding = {...onboarding, ...profile.onboarding};
  } catch (e) {
    console.warn("Personalization profile read failed:", e);
  }
}

function selectChallenges() {
  const answers = Object.values(onboarding).filter(Boolean).map(String);
  const scored = library.map(item => {
    let score = 0;
    for (const answer of answers) {
      if (item.tags.includes(answer)) score += 5;
      else if (item.tags.some(tag => tag.toLowerCase().includes(answer.toLowerCase()) || answer.toLowerCase().includes(tag.toLowerCase()))) score += 2;
    }
    return {...item, score};
  }).sort((a,b) => b.score-a.score || a.id.localeCompare(b.id));

  const signature = `${answers.join("|")}|${todayKey()}`;
  const offset = hashString(signature) % Math.max(1, scored.length);
  const rotated = scored.slice(offset).concat(scored.slice(0, offset));

  // Prefer personalized items, but always fill to exactly five.
  const preferred = rotated.filter(x => x.score > 0);
  const pool = preferred.concat(rotated.filter(x => x.score === 0));
  const chosen = [];
  const seen = new Set();

  for (const item of pool) {
    if (!seen.has(item.id)) { chosen.push(item); seen.add(item.id); }
    if (chosen.length === 5) break;
  }
  challenges = chosen;
}

function getTodayCompleted() {
  const today = todayKey();
  return challenges.filter(c => {
    const data = firebaseChallenges[String(c.id)];
    return data?.completed === true && data?.date === today;
  }).map(c => c.id);
}

function escapeHTML(value) {
  const div = document.createElement("div");
  div.textContent = String(value ?? "");
  return div.innerHTML;
}

function renderChallenges() {
  const list = document.getElementById("challengeList");
  if (!list) return;
  const completed = getTodayCompleted();

  list.innerHTML = challenges.map(item => {
    const done = completed.includes(item.id);
    return `<div class="challenge ${done ? "completed" : ""}">
      <div class="challenge-icon-small" data-emoji="${escapeHTML(item.emoji)}">${item.emoji}</div>
      <div class="challenge-content">
        <div class="challenge-title">${escapeHTML(item.title)}</div>
        <div class="challenge-desc">${escapeHTML(item.description)}</div>
        <span class="xp">+${item.xp} XP</span>
      </div>
      <button class="challenge-check" type="button" onclick="toggleChallenge('${item.id}')">${done ? "✓" : "○"}</button>
    </div>`;
  }).join("");

  updateProgress();
}

function updateProgress() {
  const completed = getTodayCompleted().length;
  const percent = Math.round((completed / 5) * 100);
  const a = document.getElementById("progressText");
  const b = document.getElementById("progressPercent");
  const c = document.getElementById("progressFill");
  if (a) a.textContent = `${completed}/5`;
  if (b) b.textContent = `${percent}%`;
  if (c) c.style.width = `${percent}%`;
}

function updateStats() {
  const map = {xp: challengeStats.xp, completedCount: challengeStats.totalCompleted, streak: challengeStats.streak, streakBig: challengeStats.streak};
  for (const [id,val] of Object.entries(map)) {
    const el = document.getElementById(id);
    if (el) el.textContent = val;
  }
}

function updateAchievements() {
  const total = Number(challengeStats.totalCompleted || 0);
  const xp = Number(challengeStats.xp || 0);
  const streak = Number(challengeStats.streak || 0);
  [["achievement1",total>=1],["achievement2",streak>=7],["achievement3",xp>=100],["achievement4",total>=20]]
    .forEach(([id,unlocked]) => document.getElementById(id)?.classList.toggle("locked",!unlocked));
}

function showToast(message) {
  const toast = document.getElementById("toast");
  if (!toast) return;
  toast.textContent = message;
  toast.classList.add("show");
  clearTimeout(window.__moveonToastTimer);
  window.__moveonToastTimer = setTimeout(() => toast.classList.remove("show"), 2200);
}

function showCelebration() {
  const el = document.getElementById("celebration");
  if (!el) return;
  el.classList.add("show");
  setTimeout(() => el.classList.remove("show"), 1800);
}

async function saveStatsFirebase() {
  if (!currentUser) return;
  await update(ref(database, `users/${currentUser.uid}/challengeStats`), {
    xp: Number(challengeStats.xp||0),
    totalCompleted: Number(challengeStats.totalCompleted||0),
    streak: challengeStats.streak || null,
    lastCompletedDate: challengeStats.lastCompletedDate || null,
    updatedAt: new Date().toISOString()
  });
}

async function toggleChallenge(id) {
  if (!currentUser || loading) return;
  const challenge = challenges.find(c => c.id === id);
  if (!challenge) return;

  const completed = getTodayCompleted();
  const already = completed.includes(id);
  loading = true;

  try {
    const path = ref(database, `users/${currentUser.uid}/challenges/${id}`);

    if (already) {
      await remove(path);
      delete firebaseChallenges[String(id)];
      challengeStats.xp = Math.max(0, challengeStats.xp - challenge.xp);
      challengeStats.totalCompleted = Math.max(0, challengeStats.totalCompleted - 1);
      await saveStatsFirebase();
      showToast("Challenge unchecked.");
    } else {
      const record = {id:challenge.id,title:challenge.title,emoji:challenge.emoji,completed:true,date:todayKey(),xp:challenge.xp,completedAt:new Date().toISOString()};
      await update(path, record);
      firebaseChallenges[String(id)] = record;
      challengeStats.xp += challenge.xp;
      challengeStats.totalCompleted += 1;

      const allDone = getTodayCompleted().length === 5;
      if (allDone && challengeStats.lastCompletedDate !== todayKey()) {
        challengeStats.streak = challengeStats.lastCompletedDate === yesterdayKey()
          ? Number(challengeStats.streak||0) + 1 : 1;
        challengeStats.lastCompletedDate = todayKey();
      }
      await saveStatsFirebase();
      showCelebration();
    }

    writeLocal();
  } catch (error) {
    console.error("Firebase challenge save failed; using local fallback:", error);
    // Keep the feature usable even if database rules/network temporarily fail.
    if (already) {
      delete firebaseChallenges[String(id)];
      challengeStats.xp = Math.max(0, challengeStats.xp - challenge.xp);
      challengeStats.totalCompleted = Math.max(0, challengeStats.totalCompleted - 1);
    } else {
      const record = {id:challenge.id,title:challenge.title,emoji:challenge.emoji,completed:true,date:todayKey(),xp:challenge.xp,completedAt:new Date().toISOString()};
      firebaseChallenges[String(id)] = record;
      challengeStats.xp += challenge.xp;
      challengeStats.totalCompleted += 1;
      if (getTodayCompleted().length === 5 && challengeStats.lastCompletedDate !== todayKey()) {
        challengeStats.streak = challengeStats.lastCompletedDate === yesterdayKey()
          ? Number(challengeStats.streak||0) + 1 : 1;
        challengeStats.lastCompletedDate = todayKey();
      }
    }
    writeLocal();
    showToast("Saved on this device. We'll sync when available.");
    if (!already) showCelebration();
  } finally {
    loading = false;
    renderChallenges();
    updateStats();
    updateAchievements();
  }
}

window.toggleChallenge = toggleChallenge;

window.resetChallenges = async function() {
  if (!currentUser || loading) return;
  const completed = getTodayCompleted();
  if (!completed.length) { showToast("There are no completed challenges to reset."); return; }
  if (!confirm("Reset today's completed challenges?")) return;

  loading = true;
  const btn = document.getElementById("resetButton");
  if (btn) { btn.disabled=true; btn.textContent="Resetting..."; }

  let xpToRemove = 0;
  for (const id of completed) {
    const c = challenges.find(x=>x.id===id);
    if (c) xpToRemove += c.xp;
  }

  try {
    const updates = {};
    for (const id of completed) updates[`users/${currentUser.uid}/challenges/${id}`] = null;
    await update(ref(database), updates);
  } catch (e) {
    console.warn("Firebase reset failed; clearing local state:", e);
  }

  completed.forEach(id => delete firebaseChallenges[String(id)]);
  challengeStats.xp = Math.max(0, challengeStats.xp - xpToRemove);
  challengeStats.totalCompleted = Math.max(0, challengeStats.totalCompleted - completed.length);
  writeLocal();
  showToast("Today's challenges were reset.");

  loading=false;
  if (btn) { btn.disabled=false; btn.textContent="Reset Today's Challenges"; }
  renderChallenges(); updateStats(); updateAchievements();
};

function applyPersonalizationText() {
  const target = document.getElementById("personalizedText");
  if (!target) return;
  const goal = onboarding.goal;
  const messages = {
    "Letting go":"These challenges are focused on helping you loosen the grip of old triggers.",
    "Thoughts":"These challenges are focused on calming your mind and understanding your feelings.",
    "Self-worth":"These challenges are focused on rebuilding confidence and self-respect.",
    "Self-growth":"These challenges are focused on building a healthier daily routine.",
    "Sleep":"These challenges are focused on creating calmer nights and better rest.",
    "Future":"These challenges are focused on helping you build what comes next."
  };
  target.textContent = messages[goal] || "Your challenges are personalized from your MoveOn onboarding choices.";
}

onAuthStateChanged(auth, async user => {
  if (!user) { window.location.href="login.html"; return; }
  currentUser = user;
  readLocal();
  await loadOnboarding();
  selectChallenges();
  applyPersonalizationText();

  try {
    const [cSnap,sSnap] = await Promise.all([
      get(ref(database, `users/${user.uid}/challenges`)),
      get(ref(database, `users/${user.uid}/challengeStats`))
    ]);
    if (cSnap.exists()) firebaseChallenges = cSnap.val() || {};
    if (sSnap.exists()) {
      const d=sSnap.val();
      challengeStats = {
        xp:Number(d.xp||0), totalCompleted:Number(d.totalCompleted||0),
        streak:Number(d.streak||0), lastCompletedDate:d.lastCompletedDate||null
      };
    }
  } catch (e) {
    console.warn("Firebase challenge load failed; local state retained:", e);
    showToast("Using your saved device progress for now.");
  }

  writeLocal();
  renderChallenges(); updateStats(); updateAchievements();
});

</script>

<script src="emoji-sounds.js"></script>
