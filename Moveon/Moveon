    <button class="save-btn" onclick="saveMood()">
        💜 Save Today's Mood
    </button>


    <!-- Weekly Overview -->

    <section class="card" style="margin-top:18px;">

        <div class="card-title">
            <h3>Your week</h3>
            <span id="averageMood">No data yet</span>
        </div>

        <div class="chart" id="chart"></div>

    </section>


    <!-- History -->

    <section class="card">

        <div class="card-title">
            <h3>Recent moods</h3>
            <span>Private</span>
        </div>

        <div id="history"></div>

    </section>

