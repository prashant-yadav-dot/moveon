);


/* =========================
   LOAD SAVED DATA
========================= */

async function loadSavedOnboarding(){

    /*
        First try Firebase.
    */

    try{

        const profile =
            await getProfile();


        if(
            profile &&
            profile.onboarding
        ){

            answers = {

                mood:
                    profile.onboarding.mood || "",

                goal:
                    profile.onboarding.goal || "",

                support:
                    profile.onboarding.support || "",

                future:
                    profile.onboarding.future || ""

            };


            localStorage.setItem(
                "moveon_onboarding",
                JSON.stringify(answers)
            );


            console.log(
                "Onboarding loaded from Firebase."
            );


            return;

        }

    }catch(error){

        console.error(
            "Firebase onboarding load error:",
            error
        );

    }


    /*
        If Firebase data isn't available,
        restore localStorage.
    */

    const saved =
        localStorage.getItem(
            "moveon_onboarding"
        );


    if(saved){

        try{

            const parsed =
                JSON.parse(saved);


            answers = {

                mood:
                    parsed.mood || "",

                goal:
                    parsed.goal || "",

                support:
                    parsed.support || "",

                future:
                    parsed.future || ""

            };

        }catch(error){

            console.error(
                "Local onboarding data error:",
                error
            );

            answers = {

                mood:"",
                goal:"",
                support:"",
                future:""

            };

        }

    }

}


/* =========================
   LOAD QUESTION
========================= */

function loadQuestion(){

    const question =
        questions[currentStep];


    document
        .getElementById("questionNumber")
        .textContent =
        currentStep + 1;


    document
        .getElementById("questionTitle")
        .textContent =
        question.title;


    document
        .getElementById("questionDescription")
        .textContent =
        question.description;


    const options =
        document.getElementById("options");


    options.innerHTML = "";


    question.options.forEach(
        function(option){

            const button =
                document.createElement("button");


            button.className =
                "option";


            button.type =
                "button";


            button.innerHTML = `

                <div class="option-icon">
                    ${option.icon}
                </div>

                <div class="option-title">
                    ${option.title}
                </div>

                <div class="option-description">
                    ${option.description}
                </div>

            `;


            button.onclick =
                function(){

                    selectOption(
                        button,
                        option.value
                    );

                };


            options.appendChild(
                button
            );

        }
    );


    /*
        Restore current answer.
    */

    const keys = [

        "mood",
        "goal",
        "support",
        "future"

    ];


    const savedAnswer =
        answers[keys[currentStep]];


    if(savedAnswer){

        document
            .querySelectorAll(".option")
            .forEach(
                function(button){

                    const title =
                        button
                            .querySelector(
                                ".option-title"
                            )
                            .textContent
                            .trim();


                    /*
                        Match using option value
                        rather than title.
                    */

                    const option =
                        question.options.find(
                            item =>
                                item.value ===
                                savedAnswer
                        );


                    if(
                        option &&
                        option.title ===
                        title
                    ){

                        button.classList.add(
                            "selected"
                        );

                    }

                }
            );

    }


    updateProgress();


    document
        .getElementById("backBtn")
        .style.display =
        currentStep === 0
        ? "none"
        : "block";

}


/* =========================
   SELECT OPTION
========================= */

function selectOption(
    button,
    value
){

    document
        .querySelectorAll(".option")
        .forEach(
            function(item){

                item.classList.remove(
                    "selected"
                );

            }
        );


    button.classList.add(
        "selected"
    );


    const keys = [

        "mood",
        "goal",
        "support",
        "future"

    ];


    answers[
        keys[currentStep]
    ] = value;


    /*
        Local backup.
    */

    localStorage.setItem(
        "moveon_onboarding",
        JSON.stringify(answers)
    );

}


/* =========================
   NEXT
========================= */

async function nextStep(){

    const keys = [

        "mood",
        "goal",
        "support",
        "future"

    ];


    if(
        !answers[
            keys[currentStep]
        ]
    ){

        showToast(
            "Choose an option to continue 💜"
        );

        return;

    }


    if(
        currentStep <
        questions.length - 1
    ){

        currentStep++;

        loadQuestion();

    }else{

        await showFinalScreen();

    }

}


/* =========================
   BACK
========================= */

function previousStep(){

    if(currentStep > 0){

        currentStep--;

        loadQuestion();

    }

}


/* =========================
   PROGRESS
========================= */

function updateProgress(){

    const percent =
        (
            (currentStep + 1) /
            questions.length
        ) * 100;


    document
        .getElementById("progressFill")
        .style.width =
        percent + "%";


    document
        .getElementById("progressPercent")
        .textContent =
        Math.round(percent) + "%";


    document
        .getElementById("progressText")
        .textContent =
        "Step " +
        (currentStep + 1) +
        " of " +
        questions.length;

}


/* =========================
   SAVE TO FIREBASE
========================= */

async function saveOnboardingToFirebase(){

    if(!firebaseUser){

        return false;

    }


    try{

        await saveProfile({

            onboarding:{

                mood:
                    answers.mood || "",

                goal:
                    answers.goal || "",

                support:
                    answers.support || "",

                future:
                    answers.future || "",

                completedAt:
                    new Date().toISOString()

            },

            profileCompleted:true

        });


        console.log(
            "Onboarding saved to Firebase."
        );


        return true;

    }catch(error){

        console.error(
            "Onboarding save error:",
            error
        );


        return false;

    }

}


/* =========================
   FINAL SCREEN
========================= */

async function showFinalScreen(){

    /*
        Save answers before showing
        final screen.
    */

    const saved =
        await saveOnboardingToFirebase();


    if(!saved){

        showToast(
            "Saved on this device. We'll sync when possible 💜"
        );

    }


    document
        .getElementById("questionCard")
        .style.display =
        "none";


    const final =
        document.getElementById(
            "finalScreen"
        );


    final.style.display =
        "flex";


    document
        .getElementById("summaryMood")
        .textContent =
        answers.mood || "Ready";


    document
        .getElementById("summaryGoal")
        .textContent =
        answers.goal || "Healing";


    document
        .getElementById("progressFill")
        .style.width =
        "100%";


    document
        .getElementById("progressPercent")
        .textContent =
        "100%";


    document
        .getElementById("progressText")
        .textContent =
        "You're ready 🌱";

}


/* =========================
   START JOURNEY
========================= */

async function startJourney(){

    /*
        Make sure Firebase has the
        latest onboarding information.
    */

    const saved =
        await saveOnboardingToFirebase();


    if(saved){

        localStorage.setItem(
            "moveon_onboarding_completed",
            "true"
        );


        window.location.href =
            "home.html";

    }else{

        /*
            If Firebase temporarily fails,
            don't lose user's local data.
        */

        localStorage.setItem(
            "moveon_onboarding_completed",
            "true"
        );


        showToast(
            "Your journey is saved locally 💜"
        );


        setTimeout(
            function(){

                window.location.href =
                    "home.html";

            },
            800
        );

    }

}


/* =========================
   SKIP
========================= */

async function skipOnboarding(){

    const confirmed =
        confirm(
            "You can complete your profile later. Skip onboarding?"
        );


    if(!confirmed){

        return;

    }


    /*
        Save skipped status to Firebase.
    */

    if(firebaseUser){

        try{

            await saveProfile({

                profileCompleted:true,

                onboardingSkipped:true,

                onboardingSkippedAt:
                    new Date().toISOString()

            });

        }catch(error){

            console.error(
                "Skip onboarding save error:",
                error
            );

        }

    }


    localStorage.setItem(
        "moveon_onboarding_completed",
        "true"
    );


    window.location.href =
        "home.html";

}


/* =========================
   TOAST
========================= */

function showToast(message){

    const toast =
        document.getElementById(
            "toast"
        );


    toast.textContent =
        message;


    toast.classList.add(
        "show"
    );


    setTimeout(
        function(){

            toast.classList.remove(
                "show"
            );

        },
        2500
    );

}


/* =========================
   GLOBAL FUNCTIONS
========================= */

/*
    Because the HTML buttons use
    onclick="", module functions
    need to be exposed globally.
*/

window.nextStep =
    nextStep;

window.previousStep =
    previousStep;

window.startJourney =
    startJourney;

window.skipOnboarding =
    skipOnboarding;

window.showToast =
    showToast;

</script>

 

