========================= */

document.addEventListener(
    "DOMContentLoaded",
    function(){

        onAuthStateChanged(
            auth,
            async function(user){

                if(!user){

                    window.location.href =
                        "login.html";

                    return;
                }


                firebaseUser = user;


                console.log(
