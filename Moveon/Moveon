} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";

import {
    ref,
    get
} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-database.js";

import {
    getJournals,
    getMoods,
    getChallenges,
    getProgress
} from "./storage.js";


/* =========================================
   DATA
========================================= */

let currentUser = null;

let journals = {};
let moods = {};
let challenges = {};
let progressData = {};
let calmSessions = {};


/* =========================================
   AUTH
========================================= */

onAuthStateChanged(auth, async (user) => {

    if (!user) {

        window.location.href = "login.html";

        return;

    }


    currentUser = user;


    await loadProgressData();

});


/* =========================================
   LOAD ALL USER DATA
========================================= */

async function loadProgressData(){

    try {

        /*
         * All calls happen only AFTER
         * Firebase confirms the user.
         */

        const results =
            await Promise.all([

                getJournals(),

                getMoods(),

                getChallenges(),

                getProgress(),

                loadCalmSessions()

            ]);


        journals =
            results[0] || {};

        moods =
            results[1] || {};

        challenges =
            results[2] || {};

        progressData =
            results[3] || {};

        calmSessions =
            results[4] || {};


        renderEverything();


    } catch(error){

        console.error(
            "Progress loading error:",
            error
        );


        /*
         * Keep the page usable even if
         * one Firebase read fails.
         */

        journals = {};
        moods = {};
        challenges = {};
        progressData = {};
        calmSessions = {};


        renderEverything();

    }

}


/* =========================================
   LOAD CALM SESSIONS
========================================= */

async function loadCalmSessions(){

    if(!currentUser){

        return {};

    }


    try{

        const snapshot =
            await get(
                ref(
                    database,
                    `users/${currentUser.uid}/calmSessions`
                )
            );


        if(snapshot.exists()){

            return snapshot.val();

        }


        return {};

    }catch(error){

        console.error(
            "Calm sessions loading error:",
            error
        );

        return {};

    }

}


/* =========================================
   OBJECT TO ARRAY
========================================= */

function objectToArray(data){

    if(!data){

        return [];

    }


    return Object.entries(data)

        .map(([id,item]) => ({

            id:id,

            ...(item || {})

        }))

        .sort((a,b) => {

            return Number(b.timestamp || 0)
                 - Number(a.timestamp || 0);

        });

}


/* =========================================
   PREPARE ARRAYS
========================================= */

function getJournalArray(){

    return objectToArray(journals);

}


function getMoodArray(){

    return objectToArray(moods);

}


function getChallengeArray(){

    return objectToArray(challenges);

}


function getCalmArray(){

    return objectToArray(calmSessions);

}


/* =========================================
   RENDER EVERYTHING
========================================= */

function renderEverything(){

    const journalArray =
        getJournalArray();

    const moodArray =
        getMoodArray();

    const challengeArray =
        getChallengeArray();

    const calmArray =
        getCalmArray();


    const completedChallenges =
        challengeArray.filter(
            item =>
                item.completed === true ||
                item.completed === "true" ||
                item.status === "completed"
        );


    const calmCount =
        calmArray.length;


    /*
     * Journal streak
     *
     * Uses Firebase progress/profile data
     * if available.
     */

    const streak =
        Number(
            progressData.journalStreak ||
            progressData.streak ||
            0
        );


    /*
     * XP
     */

    const xp =
        Number(
            progressData.totalXP ||
            progressData.xp ||
            0
        );


    /*
     * If XP is not stored yet,
     * calculate a simple temporary score.
     */

    const calculatedXP =
        xp > 0
        ? xp
        : (
            journalArray.length * 10 +
            completedChallenges.length * 20 +
            calmCount * 15 +
            moodArray.length * 5
        );


    renderStats(
        journalArray.length,
        streak,
        completedChallenges.length,
        calculatedXP
    );


    renderGrowth(
        journalArray,
        moodArray,
        completedChallenges,
        calmArray
    );


    renderMoodChart(
        moodArray
    );


    renderAchievements(
        journalArray,
        moodArray,
        completedChallenges,
        calmArray
    );


    renderOverall(
        journalArray,
        moodArray,
        completedChallenges,
        calmArray
    );

}


