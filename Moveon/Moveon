<script>
const API_URL = "/api/ex-roleplay";
const NAME_KEY = "moveon_ex_roleplay_name";
const CHAT_KEY = "moveon_ex_roleplay_chat";

const chat = document.getElementById("chat");
const input = document.getElementById("message");
const send = document.getElementById("send");
const typing = document.getElementById("typing");
const empty = document.getElementById("empty");

let exName = localStorage.getItem(NAME_KEY) || "Ex Roleplay";
let historyData = [];

try {
  const saved = JSON.parse(localStorage.getItem(CHAT_KEY) || "[]");
  historyData = Array.isArray(saved) ? saved.slice(-60) : [];
} catch {
  historyData = [];
}

function saveChat() {
  localStorage.setItem(CHAT_KEY, JSON.stringify(historyData.slice(-60)));
}

function addBubble(role, text, save = true) {
  const d = document.createElement("div");
  d.className = "bubble " + (role === "user" ? "user" : "ai");
  d.textContent = String(text || "");
  chat.insertBefore(d, typing);

  if (save) {
    historyData.push({ role, content: String(text || "") });
    saveChat();
  }

  chat.scrollTop = chat.scrollHeight;
}

function render() {
  document.getElementById("screenTitle").textContent = exName || "Ex Roleplay";
  empty.style.display = historyData.length ? "none" : "block";

  historyData.forEach(item => {
    if (item?.content) addBubble(item.role === "user" ? "user" : "assistant", item.content, false);
  });
  chat.scrollTop = chat.scrollHeight;
}

function openSettings() {
  document.getElementById("exName").value = exName === "Ex Roleplay" ? "" : exName;
  document.getElementById("settingsModal").style.display = "block";
}

function closeSettings() {
  document.getElementById("settingsModal").style.display = "none";
}

function saveSettings() {
  const value = document.getElementById("exName").value.trim().slice(0, 40);
  exName = value || "Ex Roleplay";
  localStorage.setItem(NAME_KEY, exName);
  document.getElementById("screenTitle").textContent = exName;
  closeSettings();
}

function quickSend(text) {
  input.value = text;
  sendMessage();
}

function clearChat() {
  if (!historyData.length) return;
  if (!confirm("Clear this roleplay conversation?")) return;
  historyData = [];
  saveChat();
  chat.querySelectorAll(".bubble").forEach(el => el.remove());
  empty.style.display = "block";
}

function showError(message) {
  const safe = String(message || "Unable to reply right now.");
  addBubble("assistant", "⚠️ " + safe);
}

async function sendMessage() {
  const text = input.value.trim();
  if (!text || send.disabled) return;

  addBubble("user", text);
  input.value = "";
  empty.style.display = "none";
  send.disabled = true;
  typing.style.display = "block";
  chat.scrollTop = chat.scrollHeight;

  try {
    const requestHistory = historyData
      .slice(-16)
      .filter(x => x && (x.role === "user" || x.role === "assistant") && x.content)
      .slice(0, 16);

    const res = await fetch(API_URL, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        exName,
        message: text,
        history: requestHistory
      })
    });

    const raw = await res.text();
    let data = {};
    try { data = raw ? JSON.parse(raw) : {}; } catch {}

    if (!res.ok) {
      throw new Error(data?.error || `Server error (${res.status})`);
    }

    if (!data?.reply) {
      throw new Error("The AI server returned an empty reply.");
    }

    addBubble("assistant", data.reply);
  } catch (error) {
    console.error("MoveOn Ex Roleplay error:", error);
    showError(error?.message || "Unable to reply right now. Please try again.");
  } finally {
    typing.style.display = "none";
    send.disabled = false;
    input.focus();
  }
}

input.addEventListener("keydown", event => {
  if (event.key === "Enter" && !event.shiftKey) {
    event.preventDefault();
    sendMessage();
  }
});

window.openSettings = openSettings;
window.closeSettings = closeSettings;
window.saveSettings = saveSettings;
window.quickSend = quickSend;
window.sendMessage = sendMessage;
window.clearChat = clearChat;

render();

</script>
