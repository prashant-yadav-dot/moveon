<script type="module">

import {
    auth,
    database
} from "./firebase-config.js";

import {
    onAuthStateChanged,
    signOut
} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";

import {
    ref,
    get,
    set,
    remove
} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-database.js";


let currentUser = null;


/* =========================
   AUTH
========================= */

onAuthStateChanged(
    auth,
    async (user) => {

        if(!user){

            window.location.replace(
                "login.html"
            );

            return;
        }

        currentUser = user;

        document.body.classList.add(
            "auth-ready"
        );

        await loadNoContact();

    }
);


/* =========================
   LOAD DATA
========================= */

async function loadNoContact(){

    try{

        const snapshot =
            await get(
                ref(
                    database,
                    `users/${currentUser.uid}/noContact`
                )
            );

        if(
            !snapshot.exists()
        ){

            showNotStarted();

            return;

        }

        const data =
            snapshot.val();

        if(
            !data.startDate
        ){

            showNotStarted();

            return;

        }

        updateJourney(
            data.startDate
        );

    }catch(error){

        console.error(
            "No contact load error:",
            error
        );

        showToast(
            "Unable to load journey."
        );

    }

}


/* =========================
   START JOURNEY
========================= */

window.startNoContact =
async function(){

    if(!currentUser){
        return;
    }

    const today =
        getLocalDate();

    try{

        await set(
            ref(
                database,
                `users/${currentUser.uid}/noContact`
            ),
            {
                active:true,
                startDate:today,
                startedAt:
                    new Date().toISOString()
            }
        );

        updateJourney(
            today
        );

        showToast(
            "Your No-Contact journey started 💚"
        );

    }catch(error){

        console.error(
            "No contact start error:",
            error
        );

        showToast(
            "Unable to start journey."
        );

    }

};


/* =========================
   UPDATE JOURNEY
========================= */

function updateJourney(
    startDate
){

    const start =
        new Date(
            startDate +
            "T00:00:00"
        );

    const today =
        new Date();

    const difference =
        today.getTime() -
        start.getTime();

    let days =
        Math.floor(
            difference /
            (1000 * 60 * 60 * 24)
        ) + 1;

    if(days < 1){
        days = 1;
    }

    document.getElementById(
        "streakNumber"
    ).textContent =
        days;

    document.getElementById(
        "startDate"
    ).textContent =
        "Started " +
        formatDate(start);

    document.getElementById(
        "startCard"
    ).classList.add(
        "hidden"
    );

    document.getElementById(
        "activeCard"
    ).classList.remove(
        "hidden"
    );

}


/* =========================
   NOT STARTED
========================= */

function showNotStarted(){

    document.getElementById(
        "streakNumber"
    ).textContent =
        "0";

    document.getElementById(
        "startDate"
    ).textContent =
        "Your journey hasn't started yet.";

    document.getElementById(
        "startCard"
    ).classList.remove(
        "hidden"
    );

    document.getElementById(
        "activeCard"
    ).classList.add(
        "hidden"
    );

}


/* =========================
   RESET
========================= */

window.resetNoContact =
async function(){

    const confirmReset =
        confirm(
            "Are you sure you want to end your No-Contact journey?"
        );

    if(!confirmReset){
        return;
    }

    try{

        await remove(
            ref(
                database,
                `users/${currentUser.uid}/noContact`
            )
        );

        showNotStarted();

        showToast(
            "Journey reset."
        );

    }catch(error){

        console.error(
            "Reset error:",
            error
        );

        showToast(
            "Unable to reset journey."
        );

    }

};


/* =========================
   LOCAL DATE
========================= */

function getLocalDate(){

    const now =
        new Date();

    const year =
        now.getFullYear();

    const month =
        String(
            now.getMonth() + 1
        ).padStart(
            2,
            "0"
        );

    const day =
        String(
            now.getDate()
        ).padStart(
            2,
            "0"
        );

    return (
        year +
        "-" +
        month +
        "-" +
        day
    );

}


/* =========================
   FORMAT DATE
========================= */

function formatDate(date){

    return date.toLocaleDateString(
        "en-IN",
        {
            day:"numeric",
            month:"short",
            year:"numeric"
        }
    );

}


/* =========================
   BACK
========================= */

window.goBack =
function(){

    window.location.href =
        "home.html";

};


/* =========================
   LOGOUT
========================= */

window.logout =
async function(){

    try{

        await signOut(auth);

        window.location.replace(
            "login.html"
        );

    }catch(error){

        console.error(
            "Logout error:",
            error
        );

        showToast(
            "Unable to logout."
        );

    }

};


/* =========================
   TOAST
========================= */

window.showToast =
function(message){

    const toast =
        document.getElementById(
            "toast"
        );

    if(!toast){
        return;
    }

    toast.textContent =
        message;

    toast.classList.add(
        "show"
    );

    setTimeout(
        () => {

            toast.classList.remove(
                "show"
            );

        },
        2500
    );

};

</script>

