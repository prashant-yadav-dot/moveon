<!-- Firebase + Calm Session Logic -->

<script type="module">

import { auth, database } from "./firebase-config.js";

import {
    onAuthStateChanged
} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";

import {
    ref,
    get,
    push,
    set
} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-database.js";


let selectedDuration = 60;
let remaining = selectedDuration;

let timerInterval = null;
let breathingInterval = null;

let isRunning = false;

let currentUser = null;


/* Elements */

const circle =
    document.getElementById("breathingCircle");

const instruction =
    document.getElementById("breathInstruction");

const sub =
    document.getElementById("breathSub");

const timer =
    document.getElementById("timer");

const startBtn =
    document.getElementById("startBtn");

const sessionCount =
    document.getElementById("sessionCount");


/* --------------------------------
   Firebase Authentication
-------------------------------- */

onAuthStateChanged(auth, async (user) => {

    if (!user) {

        window.location.href = "login.html";

        return;
    }

    currentUser = user;

    await loadSessions();

});


/* --------------------------------
   Duration buttons
-------------------------------- */

document
.querySelectorAll(".time-btn")
.forEach(button => {

    button.addEventListener("click", () => {

        if (isRunning) {

            showToast(
                "Finish or reset the current session first."
            );

            return;
        }

        document
        .querySelectorAll(".time-btn")
        .forEach(item => {

            item.classList.remove("active");

        });

        button.classList.add("active");

        selectedDuration =
            Number(button.dataset.time);

        remaining =
            selectedDuration;

        updateTimer();

    });

});


/* --------------------------------
   Start / Resume
-------------------------------- */

function startSession(){

    if (!currentUser) {

        showToast("Please wait...");

        return;
    }


    if (isRunning) {

        pauseSession();

        return;
    }


    if (remaining <= 0) {

        remaining =
            selectedDuration;

    }


    isRunning = true;

    startBtn.textContent =
        "⏸ Pause";


    runTimer();

    startBreathing();

}


/* --------------------------------
   Timer
-------------------------------- */

function runTimer(){

    clearInterval(timerInterval);

    timerInterval =
        setInterval(() => {

            if (!isRunning) {

                return;
            }


            remaining--;

            updateTimer();


            if (remaining <= 0) {

                finishSession();

            }

        }, 1000);

}


/* --------------------------------
   Breathing cycle
-------------------------------- */

function startBreathing(){

    clearInterval(breathingInterval);

    breathingCycle();

    breathingInterval =
        setInterval(() => {

            if (isRunning) {

                breathingCycle();

            }

        }, 14000);

}


/*
    Inhale = 4 sec
    Hold   = 4 sec
    Exhale = 6 sec
*/

function breathingCycle(){

    circle.className =
        "breathing-circle inhale";

    instruction.textContent =
        "Breathe in";

    sub.textContent =
        "Slowly • 4 seconds";


    setTimeout(() => {

        if (!isRunning) return;

        circle.className =
            "breathing-circle hold";

        instruction.textContent =
            "Hold";

        sub.textContent =
            "Stay relaxed • 4 seconds";

    }, 4000);


    setTimeout(() => {

        if (!isRunning) return;

        circle.className =
            "breathing-circle exhale";

        instruction.textContent =
            "Breathe out";

        sub.textContent =
            "Slowly • 6 seconds";

    }, 8000);

}


/* --------------------------------
   Pause
-------------------------------- */

function pauseSession(){

    isRunning = false;

    clearInterval(timerInterval);
    clearInterval(breathingInterval);

    circle.className =
        "breathing-circle";

    instruction.textContent =
        "Paused";

    sub.textContent =
        "Continue whenever you're ready";

    startBtn.textContent =
        "🌿 Resume";

}


/* --------------------------------
   Reset
-------------------------------- */

function resetSession(){

    isRunning = false;

    clearInterval(timerInterval);
    clearInterval(breathingInterval);

    remaining =
        selectedDuration;

    circle.className =
        "breathing-circle";

    instruction.textContent =
        "Ready?";

    sub.textContent =
        "Start when you're ready";

    startBtn.textContent =
        "🌿 Start Breathing";

    updateTimer();

}


/* --------------------------------
   Timer display
-------------------------------- */

function updateTimer(){

    const minutes =
        Math.floor(remaining / 60);

    const seconds =
        remaining % 60;


    timer.textContent =
        String(minutes).padStart(2, "0")
        + ":"
        + String(seconds).padStart(2, "0");

}


/* --------------------------------
   Finish Session
-------------------------------- */

async function finishSession(){

    isRunning = false;

    clearInterval(timerInterval);
    clearInterval(breathingInterval);

    remaining = 0;

    updateTimer();


    circle.className =
        "breathing-circle";

    instruction.textContent =
        "Finished";

    sub.textContent =
        "You did something kind for yourself.";

    startBtn.textContent =
        "🌿 Start Again";


    /*
       Save completed session
       to Firebase
    */

    await saveCalmSession();


    document
        .getElementById("finishModal")
        .classList.add("show");

}


/* --------------------------------
   Save Calm Session
-------------------------------- */

async function saveCalmSession(){

    if (!currentUser) {

        return false;
    }


    try {

        const sessionsRef =
            ref(
                database,
                `users/${currentUser.uid}/calmSessions`
            );


        const newSessionRef =
            push(sessionsRef);


        await set(newSessionRef, {

            durationSeconds:
                selectedDuration,

            durationMinutes:
                selectedDuration / 60,

            completed:
                true,

            completedAt:
                new Date().toISOString(),

            timestamp:
                Date.now()

        });


        await loadSessions();

        return true;


    } catch (error) {

        console.error(
            "Save Calm Session Error:",
            error
        );

        showToast(
            "Session finished, but could not be saved."
        );

        return false;

    }

}


/* --------------------------------
   Load Session Count
-------------------------------- */

async function loadSessions(){

    if (!currentUser) {

        return;
    }


    try {

        const sessionsRef =
            ref(
                database,
                `users/${currentUser.uid}/calmSessions`
            );


        const snapshot =
            await get(sessionsRef);


        if (!snapshot.exists()) {

            sessionCount.textContent = "0";

            return;
        }


        const data =
            snapshot.val();


        const sessions =
            Object.keys(data).length;


        sessionCount.textContent =
            sessions;


    } catch (error) {

        console.error(
            "Load Calm Sessions Error:",
            error
        );

        sessionCount.textContent =
            "0";

    }

}


/* --------------------------------
   Close Finish Modal
-------------------------------- */

function closeFinish(){

    document
        .getElementById("finishModal")
        .classList.remove("show");

}


/* --------------------------------
   Toast
-------------------------------- */

function showToast(message){

    const toast =
        document.getElementById("toast");


    toast.textContent =
        message;


    toast.classList.add("show");


    setTimeout(() => {

