<script type="module">

/* =========================================
   FIREBASE IMPORTS
========================================= */

import {
    auth,
    database
} from "./firebase-config.js";

import {
    onAuthStateChanged,
    updateProfile,
    signOut
} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";

import {
    ref,
    get,
    update,
    remove
} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-database.js";


/* =========================================
   GLOBAL USER
========================================= */

let currentUser = null;


/* =========================================
   AUTH CHECK
========================================= */

onAuthStateChanged(auth, async (user) => {

    if(!user){

        window.location.href = "login.html";

        return;
    }

    currentUser = user;

    await loadFirebaseProfile();

    await loadFirebaseStats();

});


/* =========================================
   LOAD PROFILE
========================================= */

async function loadFirebaseProfile(){

    if(!currentUser) return;

    try{

        const userRef =
            ref(database, "users/" + currentUser.uid);

        const snapshot =
            await get(userRef);

        const data =
            snapshot.exists()
                ? snapshot.val()
                : {};

        const name =
            data.name ||
            currentUser.displayName ||
            "MoveOn User";

        const email =
            currentUser.email ||
            data.email ||
            "Welcome to MoveOn";

        document.getElementById("profileName")
            .textContent = name;

        document.getElementById("profileEmail")
            .textContent = email;

        document.getElementById("nameInput")
            .value =
            name === "MoveOn User"
                ? ""
                : name;

        document.getElementById("emailInput")
            .value =
            email === "Welcome to MoveOn"
                ? ""
                : email;

        document.getElementById("avatar")
            .textContent = getInitials(name);

    }catch(error){

        console.error(
            "Profile loading error:",
            error
        );

        document.getElementById("profileName")
            .textContent =
            currentUser.displayName ||
            "MoveOn User";

        document.getElementById("profileEmail")
            .textContent =
            currentUser.email ||
            "Welcome to MoveOn";

    }

}


/* =========================================
   INITIALS
========================================= */

function getInitials(name){

    if(!name) return "💜";

    const words =
        name.trim().split(/\s+/);

    if(words.length === 1){

        return words[0]
            .substring(0,2)
            .toUpperCase();

    }

    return (
        words[0][0] +
        words[words.length - 1][0]
    ).toUpperCase();

}


/* =========================================
   LOAD FIREBASE STATS
========================================= */

async function loadFirebaseStats(){

    if(!currentUser) return;

    try{

        const uid = currentUser.uid;

        const userRef =
            ref(database, "users/" + uid);

        const snapshot =
            await get(userRef);

        if(!snapshot.exists()){

            setStats(0,0,0,0);

            return;
        }

        const data =
            snapshot.val();

        const journals =
            data.journal || {};

        const moods =
            data.moods || {};

        const challenges =
            data.challenges || {};

        const calmSessions =
            data.calmSessions || {};

        const journalCount =
            Object.keys(journals).length;

        const moodCount =
            Object.keys(moods).length;

        let challengeCount = 0;

        Object.values(challenges)
            .forEach(challenge => {

                if(
                    challenge &&
                    (
                        challenge.completed === true ||
                        challenge.completed === "true" ||
                        challenge.status === "completed"
                    )
                ){

                    challengeCount++;

                }

            });

        const calmCount =
            Object.keys(calmSessions).length;


        setStats(
            journalCount,
            moodCount,
            challengeCount,
            calmCount
        );

    }catch(error){

        console.error(
            "Stats loading error:",
            error
        );

        setStats(0,0,0,0);

    }

}


/* =========================================
   SET STATS
========================================= */

function setStats(
    journalCount,
    moodCount,
    challengeCount,
    calmCount
){

    document.getElementById("journalCount")
        .textContent = journalCount;

    document.getElementById("moodCount")
        .textContent = moodCount;

    document.getElementById("challengeCount")
        .textContent = challengeCount;

    document.getElementById("calmCount")
        .textContent = calmCount;


    /* Achievements */

    if(journalCount >= 1){

        document
            .getElementById("badgeJournal")
            .classList.remove("locked");

    }

    if(moodCount >= 1){

        document
            .getElementById("badgeMood")
            .classList.remove("locked");

    }

    if(challengeCount >= 5){

        document
            .getElementById("badgeChallenge")
            .classList.remove("locked");

    }

    if(calmCount >= 5){

        document
            .getElementById("badgeCalm")
            .classList.remove("locked");

    }

}


/* =========================================
   EDIT PROFILE
========================================= */

window.openEdit = function(){

    document
        .getElementById("editModal")
        .classList.add("show");

};


window.closeEdit = function(){

    document
        .getElementById("editModal")
        .classList.remove("show");

};


/* =========================================
   SAVE PROFILE
========================================= */

window.saveProfile = async function(){

    if(!currentUser){

        alert("Please log in first.");

        return;
    }


    const name =
        document
            .getElementById("nameInput")
            .value
            .trim();

    const email =
        document
            .getElementById("emailInput")
            .value
            .trim();


    if(!name){

        alert("Please enter your name.");

        return;
    }


    if(!email){

        alert("Please enter your email.");

        return;
    }


    const saveButton =
        document.querySelector(".save");

    saveButton.disabled = true;

    saveButton.textContent = "Saving...";


    try{

        /*
           IMPORTANT:
           Firebase Auth email is NOT changed here.
           The email field is saved as profile information.
        */

        await updateProfile(
            currentUser,
            {
                displayName: name
            }
        );


        await update(
            ref(
                database,
                "users/" + currentUser.uid
            ),
            {
                name: name,
                email: email,
                updatedAt:
                    new Date().toISOString()
            }
        );


        document.getElementById("profileName")
            .textContent = name;

        document.getElementById("profileEmail")
            .textContent = email;

        document.getElementById("avatar")
            .textContent = getInitials(name);


        closeEdit();

        alert("Profile updated successfully. 💜");

    }catch(error){

        console.error(
            "Save profile error:",
            error
        );

        alert(
            "Unable to save profile. Please try again."
        );

    }finally{

        saveButton.disabled = false;

        saveButton.textContent = "Save";

    }

};


/* =========================================
   RESET FIREBASE DATA
========================================= */

window.clearMoveOnData = async function(){

    if(!currentUser){

        alert("Please log in first.");

        return;
    }


    const confirmReset =
        confirm(
            "Are you sure you want to delete your MoveOn progress? This cannot be undone."
        );


    if(!confirmReset) return;


    try{

        const uid =
            currentUser.uid;


        /*
           Only progress-related data is deleted.
           Account/profile remains safe.
        */

        const userRef =
            ref(database, "users/" + uid);


        await update(
            userRef,
            {
                journal: null,
                moods: null,
                challenges: null,
                calmSessions: null,
                progress: null
            }
        );


        /* Also clear old local data */

        const localKeys = [

            "moveon_journal_entries",
            "moveon_journal_mood",
            "moveon_journal_streak",
            "moveon_moods",
            "moveon_challenges",
            "moveon_total_xp",
            "moveon_challenge_streak",
            "moveon_total_completed",
            "moveon_last_challenge_date",
            "moveon_calm_sessions"

        ];


        localKeys.forEach(key => {

            localStorage.removeItem(key);

        });


        alert(
            "Your MoveOn progress has been reset. 💜"
        );


        location.reload();

    }catch(error){

        console.error(
            "Reset data error:",
            error
        );

        alert(
            "Unable to reset your data. Please try again."
        );

    }

};


/* =========================================
   FIREBASE LOGOUT
========================================= */

window.logout = async function(){

    const confirmLogout =
        confirm("Do you want to log out?");


    if(!confirmLogout) return;


    try{

        await signOut(auth);

        /*
           Firebase automatically clears
           the authenticated session.
        */

        window.location.href =
            "login.html";

    }catch(error){

        console.error(
            "Logout error:",
            error
        );

        alert(
            "Unable to logout. Please try again."
        );

    }

};


/* =========================================
   COMING SOON
========================================= */

window.comingSoon = function(){

