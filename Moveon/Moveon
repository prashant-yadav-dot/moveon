/* =========================================
   GROWTH PROGRESS
========================================= */

function renderGrowth(
    journalsArray,
    moodsArray,
    challengesArray,
    calmArray
){

    const journalCount =
        journalsArray.length;


    const challengeCount =
        challengesArray.length;


    const calmCount =
        calmArray.length;


    const moodCount =
        moodsArray.length;


    const journalScore =
        Math.min(
            journalCount / 7,
            1
        );


    const challengeScore =
        Math.min(
            challengeCount / 5,
            1
        );


    const calmScore =
        Math.min(
            calmCount / 5,
            1
        );


    const moodScore =
        Math.min(
            moodCount / 7,
            1
        );


    setProgress(

        "journalFill",
        "journalPercent",
        "journalProgressText",

        journalScore,

        `${Math.min(journalCount,7)} / 7 entries`

    );


    setProgress(

        "challengeFill",
        "challengePercent",
        "challengeProgressText",

        challengeScore,

        `${Math.min(challengeCount,5)} / 5 today`

    );


    setProgress(

        "calmFill",
        "calmPercent",
        "calmProgressText",

        calmScore,

        `${Math.min(calmCount,5)} / 5 sessions`

    );


    setProgress(

        "moodFill",
        "moodPercent",
        "moodProgressText",

        moodScore,

        `${Math.min(moodCount,7)} / 7 check-ins`

    );

}


/* =========================================
   PROGRESS BAR
========================================= */

function setProgress(
    fillId,
    percentId,
    textId,
    score,
    text
){

    const percent =
        Math.round(
            Math.max(
                0,
                Math.min(
                    score * 100,
                    100
                )
            )
        );


    document.getElementById(
        fillId
    ).style.width =
        percent + "%";


    document.getElementById(
        percentId
    ).textContent =
        percent + "%";


    document.getElementById(
        textId
    ).textContent =
        text;

}


/* =========================================
   OVERALL PROGRESS
========================================= */

function renderOverall(
    journalsArray,
    moodsArray,
    challengesArray,
    calmArray
){

    const journalScore =
        Math.min(
            journalsArray.length / 7,
            1
        );


    const moodScore =
        Math.min(
            moodsArray.length / 7,
            1
        );


    const challengeScore =
        Math.min(
            challengesArray.length / 5,
            1
        );


    const calmScore =
        Math.min(
            calmArray.length / 5,
            1
        );


    const overall =
        Math.round(

            (
                journalScore +
                moodScore +
                challengeScore +
                calmScore

            ) / 4 * 100

        );


    document.getElementById(
        "overallPercent"
    ).textContent =
        overall + "%";


    const degrees =
        overall * 3.6;


    document.getElementById(
        "progressRing"
    ).style.background =

        `conic-gradient(
            #7667f8 0deg,
            #a18cff ${degrees}deg,
            #eeeaff ${degrees}deg
        )`;

}


/* =========================================
   MOOD CHART
========================================= */

function renderMoodChart(moodsArray){

    const chart =
        document.getElementById(
            "moodChart"
        );


    chart.innerHTML = "";


    const today =
        new Date();


    const days = [];


    for(let i = 6; i >= 0; i--){

        const date =
            new Date(today);


        date.setDate(
            today.getDate() - i
        );


        days.push(date);

    }


    const values =
        days.map(day => {

            const year =
                day.getFullYear();


            const month =
                String(
                    day.getMonth() + 1
                ).padStart(2,"0");


            const date =
                String(
                    day.getDate()
                ).padStart(2,"0");


            const localISO =
                `${year}-${month}-${date}`;


            /*
             * Try timestamp first.
             */

            const entries =
                moodsArray.filter(item => {

                    if(!item.timestamp){

                        return false;

                    }


                    const itemDate =
                        new Date(
                            Number(
                                item.timestamp
                            )
                        );


                    return (

                        itemDate.getFullYear()
                        ===
                        year

                        &&

                        itemDate.getMonth()
                        ===
                        day.getMonth()

                        &&

                        itemDate.getDate()
                        ===
                        day.getDate()

                    );

                });


            if(entries.length){

                return Number(
                    entries[0].intensity || 0
                );

            }


            /*
             * Fallback for entries that only
             * have a date string.
             */

            const fallback =
                moodsArray.find(item => {

                    return item.date ===
                        day.toLocaleDateString();

                });


            return fallback
                ? Number(
                    fallback.intensity || 0
                  )
                : 0;

        });


    days.forEach((day,index) => {

        const wrap =
            document.createElement(
                "div"
            );


        wrap.className =
            "bar-wrap";


        const bar =
            document.createElement(
                "div"
            );


        bar.className =
            "bar";


        const value =
            values[index];


        const height =
            value > 0
            ? Math.max(
                10,
                value * 10
              )
            : 10;


        bar.style.height =
            height + "%";


        if(!value){

            bar.style.opacity =
                ".18";

        }


        bar.title =
            value
            ? value + "/10"
            : "No mood entry";


        const label =
            document.createElement(
                "div"
            );


        label.className =
            "day";


        label.textContent =
            day.toLocaleDateString(
                "en-US",
                {
                    weekday:"short"
                }
            );


        wrap.appendChild(bar);

        wrap.appendChild(label);

        chart.appendChild(wrap);

    });

}


/* =========================================
   ACHIEVEMENTS
========================================= */

function renderAchievements(
    journalsArray,
    moodsArray,
    challengesArray,
    calmArray
){

    const journalBadge =
        document.getElementById(
            "badgeJournal"
        );


    const moodBadge =
        document.getElementById(
            "badgeMood"
        );


    const challengeBadge =
        document.getElementById(
            "badgeChallenge"
        );


    const calmBadge =
        document.getElementById(
            "badgeCalm"
        );


    /*
     * Reset first
     */

    journalBadge.classList.add(
        "locked"
    );

    moodBadge.classList.add(
        "locked"
    );

    challengeBadge.classList.add(
        "locked"
    );

    calmBadge.classList.add(
        "locked"
    );


    /*
     * First journal
     */

    if(journalsArray.length >= 1){

        journalBadge.classList.remove(
            "locked"
        );

    }


    /*
     * First mood
     */

    if(moodsArray.length >= 1){

        moodBadge.classList.remove(
            "locked"
        );

    }


    /*
     * 5 challenges
     */

    if(challengesArray.length >= 5){

        challengeBadge.classList.remove(
            "locked"
        );

    }


    /*
     * 5 calm sessions
     */

    if(calmArray.length >= 5){

        calmBadge.classList.remove(
            "locked"
        );

    }

}


