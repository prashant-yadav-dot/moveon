        } catch (error) {

            console.error(
                "Contact Firebase Error:",
                error
            );


            /*
               Firebase permission error
            */

            if (
                error.code ===
                "PERMISSION_DENIED"
            ) {

                showToast(
                    "Permission denied. Please login again."
                );

            } else if (
                error.code ===
                "NETWORK_ERROR"
            ) {

                showToast(
                    "Network error. Please try again."
                );

            } else {

                showToast(
                    "Unable to send message. Please try again."
                );

            }

        }


        /* Restore button */

        sendButton.disabled = false;

        sendButton.textContent =
            "💜 Send Message";

