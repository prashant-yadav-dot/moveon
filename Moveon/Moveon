<script type="module">

import { auth, database } from "./firebase-config.js";

import {
    onAuthStateChanged
} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";

import {
    ref,
    push,
    set
} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-database.js";


/* =========================================
   GLOBAL VARIABLES
========================================= */

let currentUser = null;

let authReady = false;


/* =========================================
   DOM ELEMENTS
========================================= */

const form =
    document.getElementById("contactForm");

const sendButton =
    document.getElementById("sendBtn");

const nameInput =
    document.getElementById("name");

const emailInput =
    document.getElementById("email");

const topicInput =
    document.getElementById("topic");

const messageInput =
    document.getElementById("message");


/* =========================================
   AUTH STATE
========================================= */

onAuthStateChanged(auth, (user) => {

    authReady = true;

    if (!user) {

        currentUser = null;

        window.location.href =
            "login.html";

        return;

    }


    currentUser = user;


    /*
       Automatically use Firebase
       account information.
    */

    if (!nameInput.value.trim()) {

        nameInput.value =
            user.displayName || "";

    }


    if (!emailInput.value.trim()) {

        emailInput.value =
            user.email || "";

    }

});


/* =========================================
   CONTACT FORM
========================================= */

form.addEventListener(
    "submit",
    async function(event) {

        event.preventDefault();


        /* Wait for Firebase Auth */

        if (!authReady) {

            showToast(
                "Please wait a moment..."
            );

            return;

        }


        /* Check logged-in user */

        if (!currentUser) {

            showToast(
                "Please login first 💜"
            );

            setTimeout(() => {

                window.location.href =
                    "login.html";

            }, 1000);

            return;

        }


        const name =
            nameInput.value.trim();

        const email =
            emailInput.value.trim();

        const topic =
            topicInput.value;

        const message =
            messageInput.value.trim();


        /* Validation */

        if (!name) {

            showToast(
                "Please enter your name."
            );

            nameInput.focus();

            return;

        }


        if (!email) {

            showToast(
                "Please enter your email."
            );

            emailInput.focus();

            return;

        }


        if (!message) {

            showToast(
                "Please write your message."
            );

            messageInput.focus();

            return;

        }


        /*
           Email format validation
        */

        const emailPattern =
            /^[^\s@]+@[^\s@]+\.[^\s@]+$/;


        if (!emailPattern.test(email)) {

            showToast(
                "Please enter a valid email."
            );

            emailInput.focus();

            return;

        }


        /* Loading state */

        sendButton.disabled = true;

        sendButton.textContent =
            "Sending...";


        try {


            /*
               Firebase path:

               users
                 └── UID
                      └── contactMessages
                           └── messageId
            */

            const messagesRef =
                ref(
                    database,
                    `users/${currentUser.uid}/contactMessages`
                );


            const newMessageRef =
                push(messagesRef);


            await set(
                newMessageRef,
                {

                    name: name,

                    email: email,

                    topic: topic || "General",

                    message: message,

                    createdAt:
                        new Date().toISOString(),

                    timestamp:
                        Date.now(),

                    status:
                        "new"

                }
            );


            /*
               Clear form after
