<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>MoveOn — Calm Space</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    font-family:Arial,sans-serif;
    min-height:100vh;
    color:#29273d;
    background:
        radial-gradient(circle at 15% 10%,#ded9ff,transparent 30%),
        radial-gradient(circle at 90% 35%,#d9f7ef,transparent 28%),
        linear-gradient(135deg,#f7f7ff,#f4fffc);
    overflow-x:hidden;
}

.blob{
    position:fixed;
    border-radius:50%;
    z-index:-1;
    opacity:.5;
    filter:blur(2px);
    animation:float 9s ease-in-out infinite;
}

.blob.one{
    width:190px;
    height:190px;
    background:#d2ccff;
    left:-90px;
    top:90px;
}

.blob.two{
    width:230px;
    height:230px;
    background:#c8f1e5;
    right:-110px;
    bottom:80px;
    animation-delay:2s;
}

@keyframes float{
    0%,100%{
        transform:translateY(0);
    }

    50%{
        transform:translateY(-25px);
    }
}

.header{
    padding:20px;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.brand{
    display:flex;
    align-items:center;
    gap:10px;
}

.logo{
    width:45px;
    height:45px;
    border-radius:15px;
    background:linear-gradient(135deg,#7667f8,#9a8cff);
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:22px;
    box-shadow:0 10px 25px #7667f833;
}

.brand h2{
    font-size:19px;
}

.brand p{
    font-size:11px;
    color:#908ca0;
    margin-top:3px;
}

.back{
    width:42px;
    height:42px;
    border:none;
    border-radius:14px;
    background:#ffffffc2;
    backdrop-filter:blur(12px);
    font-size:20px;
    cursor:pointer;
    box-shadow:0 8px 20px #39306112;
}

.container{
    width:min(720px,92%);
    margin:auto;
    padding:8px 0 40px;
}

.hero{
    text-align:center;
    padding:5px 0 20px;
}

.hero h1{
    font-size:29px;
    margin-bottom:8px;
}

.hero p{
    color:#858298;
    font-size:14px;
    line-height:1.6;
}

.breathing-area{
    min-height:365px;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    position:relative;
}

.breathing-circle{
    width:220px;
    height:220px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    background:
        radial-gradient(circle,#ffffff 0%,#e8e4ff 55%,#dcd6ff 100%);
    box-shadow:
        0 0 0 18px #7667f80b,
        0 0 0 38px #7667f806,
        0 25px 70px #7667f82b;
    transition:
        transform 4s ease-in-out,
        box-shadow 4s ease-in-out;
}

.breathing-circle.inhale{
    transform:scale(1.23);
    box-shadow:
        0 0 0 25px #7667f80d,
        0 0 0 50px #7667f806,
        0 30px 90px #7667f82e;
}

.breathing-circle.hold{
    transform:scale(1.23);
}

.breathing-circle.exhale{
    transform:scale(.86);
    box-shadow:
        0 0 0 12px #7667f807,
        0 0 0 28px #7667f803,
        0 15px 45px #7667f81c;
}

.breath-text{
    position:relative;
    z-index:2;
}

.breath-text strong{
    display:block;
    font-size:18px;
    color:#7667f8;
}

.breath-text span{
    display:block;
    margin-top:6px;
    color:#9995a8;
    font-size:11px;
}

.session-time{
    margin-top:25px;
    font-size:14px;
    color:#777388;
}

.session-time strong{
    color:#7667f8;
    font-size:20px;
}

.controls{
    display:flex;
    justify-content:center;
    gap:10px;
    margin-top:15px;
    flex-wrap:wrap;
}

.time-btn{
    border:1px solid #e6e2f2;
    background:#ffffffb8;
    color:#777388;
    padding:10px 16px;
    border-radius:30px;
    cursor:pointer;
    font-size:11px;
    transition:.2s;
}

.time-btn.active,
.time-btn:hover{
    background:#7667f8;
    border-color:#7667f8;
    color:white;
}

.action-row{
    display:flex;
    gap:10px;
    margin-top:18px;
    width:100%;
    justify-content:center;
}

.start-btn,
.reset-btn{
    border:none;
    border-radius:16px;
    padding:13px 25px;
    cursor:pointer;
    font-size:13px;
    font-weight:bold;
    transition:.2s;
}

.start-btn{
    color:white;
    background:linear-gradient(135deg,#7667f8,#9d90ff);
    box-shadow:0 12px 25px #7667f833;
}

.start-btn:hover{
    transform:translateY(-2px);
}

.reset-btn{
    background:#ffffffb8;
    border:1px solid #e5e1f1;
    color:#858194;
}

.reset-btn:hover{
    background:white;
}

.card{
    background:#ffffffb8;
    border:1px solid #fff;
    backdrop-filter:blur(16px);
    border-radius:24px;
    padding:20px;
    margin-bottom:16px;
    box-shadow:0 15px 40px #463b7d10;
}

.card-title{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom:15px;
}

.card-title h3{
    font-size:17px;
}

.card-title span{
    color:#9995a8;
    font-size:10px;
}

.steps{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:10px;
}

.step{
    text-align:center;
    padding:14px 8px;
    border-radius:18px;
    background:#faf9ff;
}

.step-icon{
    font-size:25px;
    margin-bottom:8px;
}

.step strong{
    display:block;
    font-size:12px;
}

.step span{
    display:block;
    margin-top:5px;
    color:#9995a8;
    font-size:9px;
}

.grounding-intro{
    color:#8d899b;
    font-size:12px;
    line-height:1.6;
    margin-bottom:15px;
}

.grounding{
    display:grid;
    gap:9px;
}

.ground-item{
    display:flex;
    align-items:center;
    gap:11px;
    padding:12px;
    border-radius:16px;
    background:#faf9ff;
}

.ground-number{
    width:34px;
    height:34px;
    border-radius:11px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#eeeaff;
    color:#7667f8;
    font-weight:bold;
    font-size:12px;
}

.ground-item span{
    color:#777388;
    font-size:11px;
}

.quick-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
}

.quick{
    text-decoration:none;
    color:#29273d;
    padding:15px;
    border-radius:18px;
    background:#faf9ff;
    border:1px solid #ebe8f5;
    transition:.2s;
}

.quick:hover{
    transform:translateY(-3px);
    border-color:#7667f8;
}

.quick-icon{
    font-size:23px;
    margin-bottom:7px;
}

.quick strong{
    display:block;
    font-size:12px;
}

.quick span{
    display:block;
    margin-top:4px;
    color:#9995a8;
    font-size:9px;
    line-height:1.4;
}

.history{
    text-align:center;
    padding:8px 0;
    color:#9995a8;
    font-size:11px;
}

.history strong{
    color:#7667f8;
}

.support{
    background:linear-gradient(135deg,#eeeaff,#e7faf4);
    border-radius:22px;
    padding:20px;
    margin-bottom:16px;
}

.support h3{
    font-size:16px;
    margin-bottom:7px;
}

.support p{
    color:#777388;
    font-size:11px;
    line-height:1.6;
}

.support a{
    display:inline-block;
    margin-top:13px;
    text-decoration:none;
    background:white;
    color:#7667f8;
    padding:10px 14px;
    border-radius:13px;
    font-size:11px;
    font-weight:bold;
}

.toast{
    position:fixed;
    left:50%;
    bottom:25px;
    transform:translate(-50%,120px);
    opacity:0;
    background:#29263b;
    color:white;
    padding:13px 19px;
    border-radius:30px;
    font-size:12px;
    transition:.35s;
    z-index:30;
}

.toast.show{
    transform:translate(-50%,0);
    opacity:1;
}

.finish{
    position:fixed;
    inset:0;
    background:#28253b66;
    backdrop-filter:blur(5px);
    display:none;
    align-items:center;
    justify-content:center;
    z-index:40;
    padding:20px;
}

.finish.show{
    display:flex;
}

.finish-box{
    width:min(350px,100%);
    background:white;
    border-radius:27px;
    padding:28px;
    text-align:center;
    box-shadow:0 25px 70px #0003;
    animation:pop .4s ease;
}

.finish-icon{
    font-size:50px;
    margin-bottom:10px;
}

.finish-box h2{
    font-size:21px;
}

.finish-box p{
    color:#8d899b;
    font-size:12px;
    line-height:1.6;
    margin:8px 0 18px;
}

.close-finish{
    border:none;
    background:#7667f8;
    color:white;
    padding:12px 22px;
    border-radius:14px;
    cursor:pointer;
    font-weight:bold;
}

@keyframes pop{
    from{
        transform:scale(.7);
        opacity:0;
    }

    to{
        transform:scale(1);
        opacity:1;
    }
}

@media(max-width:500px){

    .hero h1{
        font-size:25px;
    }

    .breathing-area{
        min-height:340px;
    }

    .breathing-circle{
        width:190px;
        height:190px;
    }

    .breathing-circle.inhale,
    .breathing-circle.hold{
        transform:scale(1.18);
    }

    .steps{
        grid-template-columns:1fr;
    }

    .quick-grid{
        grid-template-columns:1fr 1fr;
    }
}
</style>
</head>

